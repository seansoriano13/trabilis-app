# ===================================
# TRABILIS FRONTEND - ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your actual values
# Never commit the actual .env file to version control

# ===================================
# API CONFIGURATION (AUTO-DETECTED!)
# ===================================
# Backend API URL - Auto-detected based on environment:
# - Development: Uses http://localhost:3001 (via vite proxy)
# - Production: Uses the value below
# Just set this once and it works everywhere!
VITE_BACKEND_URL=https://trabilis.onrender.com

# ===================================
# DATABASE - SUPABASE
# ===================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===================================
# EXTERNAL SERVICES
# ===================================
# OpenWeather API: https://openweathermap.org/api
VITE_OPEN_WEATHER_API_KEY=your-openweather-api-key