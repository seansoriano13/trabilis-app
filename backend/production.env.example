# Production Environment Variables for Render
# Copy these to your Render environment variables

# Application
NODE_ENV=production
PORT=3001

# Database
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email Service (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_from_email_here

# Amadeus API
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=1d

# Image Upload Services
TINIFY_API_KEY=your_tinify_api_key_here
IMG_BB_API_KEY=your_imgbb_api_key_here
IMG_BB_API_URL=https://api.imgbb.com/1/upload

# Pusher (for real-time notifications)
PUSHER_APP_ID=your_pusher_app_id_here
PUSHER_APP_KEY=your_pusher_app_key_here
PUSHER_APP_SECRET=your_pusher_app_secret_here
PUSHER_APP_CLUSTER=your_pusher_cluster_here

# Capacity Management
DAILY_BOOKING_LIMIT=50
UNTICKETED_BOOKING_LIMIT=100
AUTO_PAUSE_THRESHOLD=80
CRITICAL_THRESHOLD=90

# Support Contact Information
SUPPORT_EMAIL=support@trabilis.com
SUPPORT_PHONE=9296106660
TEST_EMAIL=test@trabilis.com

# URLs (auto-detected in production)
FRONTEND_URL=https://trabilis.vercel.app
BACKEND_URL=your_render_url_here
