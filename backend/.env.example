# ===================================
# TRABILIS BACKEND - ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your actual values
# Never commit the actual .env file to version control

# ===================================
# ENVIRONMENT & SERVER (AUTO-DETECTED!)
# ===================================
# NOTE: URLs are auto-detected! You don't need to set these for deployment.
# - NODE_ENV: Auto-set by Render in production
# - PORT: Auto-set by Render in production
# - BACKEND_URL: Auto-detected from RENDER_EXTERNAL_URL in production
# - FRONTEND_URL: Optional, defaults to https://trabilis.vercel.app in production
#
# Just upload this .env to Render and it works! 🚀

# ===================================
# DATABASE - SUPABASE
# ===================================
# Supabase project URL (found in Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public, safe to expose in frontend)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (PRIVATE - never expose in frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===================================
# AMADEUS FLIGHT API
# ===================================
# Get credentials from: https://developers.amadeus.com
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret

# ===================================
# STRIPE PAYMENT PROCESSING
# ===================================
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===================================
# EMAIL SERVICE - BREVO
# ===================================
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=noreply@yourdomain.com

# ===================================
# JWT AUTHENTICATION
# ===================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-long-random-secret-key-here
JWT_EXPIRES_IN=1d

# ===================================
# IMAGE UPLOAD
# ===================================
# Tinify (optional): https://tinypng.com/developers
TINIFY_API_KEY=your-tinify-api-key

# ImgBB: https://api.imgbb.com/
IMG_BB_API_KEY=your-imgbb-api-key
IMG_BB_API_URL=https://api.imgbb.com/1/upload
