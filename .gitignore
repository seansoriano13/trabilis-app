# Root-level node_modules (if any)
/node_modules/

# Dependency directories
/backend/node_modules/
/frontend/node_modules/

# Build output
/backend/dist/
/frontend/dist/

# Environment variables
*.env
.env.*
!/example.env  # (Optional: if you want to include a safe template)

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System files
.DS_Store
Thumbs.db

# IDE/editor settings
.vscode/
.idea/

# OS-generated files
*.swp
*.swo

# Optional: Vite cache
/frontend/.vite/

# Optional: Windows-specific files
ehthumbs.db
Desktop.ini
