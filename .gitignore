.env.example
**/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# Test and development files
/backend/test-outputs/
/backend/test-*.png
/backend/test-*.jpg
/backend/test-*.pdf
/backend/tests/
*.test.local.*

